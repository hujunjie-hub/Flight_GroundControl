{
  "schema": "flight-groundcontrol-issue-workflow/1.1",
  "issue_system_of_record": "GitHub Issues",
  "issue_id_format": "FGC-{github_issue_number:04d}",
  "no_duplicate_csv_or_markdown_ledger": true,
  "status_field_location": "GitHub Issue body: Current status",
  "status_history_location": "Append-only GitHub Issue comments",
  "statuses": [
    "NEW",
    "TRIAGED",
    "NEEDS_INFO",
    "REPRODUCED",
    "IN_PROGRESS",
    "FIXED_WAITING_RETEST",
    "RETESTING",
    "BLOCKED",
    "REOPENED",
    "VERIFIED",
    "CLOSED"
  ],
  "standard_flow": [
    "NEW",
    "TRIAGED",
    "REPRODUCED",
    "IN_PROGRESS",
    "FIXED_WAITING_RETEST",
    "RETESTING",
    "VERIFIED",
    "CLOSED"
  ],
  "severity": [
    "S0-CRITICAL",
    "S1-HIGH",
    "S2-MEDIUM",
    "S3-LOW"
  ],
  "types": [
    "BUG",
    "SAFETY",
    "TEST_GAP",
    "SPEC_DEFECT",
    "INTEGRATION",
    "BUILD",
    "ENVIRONMENT",
    "PERFORMANCE",
    "ENHANCEMENT"
  ],
  "test_result_states": [
    "PASS",
    "FAIL",
    "PARTIAL",
    "NOT_RUN",
    "UNVERIFIED"
  ],
  "test_result_and_issue_status_are_independent": true,
  "run_id_format": "YYYYMMDDTHHMMSSfffZ_<groundcontrol-commit-short>",
  "evidence_root": "work/validation/archives",
  "archive_command": "pwsh -File ./tools/validation/Archive-WindowsReleaseRun.ps1",
  "archive_contains": [
    "configure.log",
    "build.log",
    "unit-ctest.log",
    "integration-ctest.log",
    "junit-results-windows-unit.xml",
    "junit-results-windows-integration.xml",
    "LOCAL_VALIDATION_REPORT.md",
    "environment.json",
    "run-manifest.json",
    "SHA-256 for each archived artifact"
  ],
  "canonical_locations": {
    "policy": "spec/quality/ISSUE_WORKFLOW.md",
    "closure_checklist": "spec/quality/ISSUE_CLOSURE_CHECKLIST.md",
    "github_issue_template": ".github/ISSUE_TEMPLATE/groundcontrol-validation-issue.yml",
    "acceptance_spec": "spec/Windows-Release验收与交付.md",
    "versioned_test_manifest": "spec/validation/windows_release_acceptance_manifest.json",
    "local_build_guide": "spec/本地Windows开发与调试指南.md",
    "transient_reports": "work/validation/current/",
    "immutable_run_archives": "work/validation/archives/<RUN_ID>/",
    "run_zip": "work/validation/archives/<RUN_ID>.zip",
    "agent_entrypoint": "spec/AGENT-操作指南.md"
  },
  "closure_requires": [
    "confirmed root cause or accepted explicit disposition",
    "fix commit/PR",
    "new regression RUN_ID matching exact source commit",
    "original failing test passed after fix",
    "relevant adjacent tests passed",
    "no PARTIAL/NOT_RUN/UNVERIFIED promoted to PASS",
    "issue body and append-only status history updated"
  ],
  "issue_numbering_note": "GitHub Issues and Pull Requests share the repository issue-number sequence; derive FGC ID from the actual GitHub Issue number. Do not assume the first issue is #1.",
  "zip_checksum_sidecar": "work/validation/archives/<RUN_ID>.zip.sha256",
  "delivery_branch_policy": {
    "primary_branch": "main",
    "long_lived_feature_branches": false,
    "force_push": false,
    "pr_flow": "only_when_explicitly_requested"
  },
  "issue_status_source_note": "Dynamic issue status is authoritative only in GitHub Issues; spec files define policy and preserve dated evidence snapshots, not a second live issue ledger."
}
