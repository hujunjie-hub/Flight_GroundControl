{
  "schema": "flight-groundcontrol-windows-release-acceptance/1.2",
  "repository": "hujunjie-hub/Flight_GroundControl",
  "branch": "main",
  "delivery": {
    "local_shell": "PowerShell 7",
    "local_validation_before_push": true,
    "remote_verification_after_push": true
  },
  "product_target": {
    "os": "Windows x64",
    "compiler": "MSVC 2022 x64",
    "build_type": "Release",
    "generator": "Ninja"
  },
  "dependency_source": ".github/build-config.json",
  "configured_dependencies": {
    "qt_version_at_manifest_creation": "6.11.1",
    "qt_arch": "win64_msvc2022_64",
    "gstreamer_windows_version_at_manifest_creation": "1.28.4",
    "cmake_minimum": "3.25"
  },
  "forbidden_product_targets": [
    "Linux x64",
    "macOS",
    "iOS",
    "Android",
    "ARM64",
    "Windows Debug",
    "RelWithDebInfo",
    "MinSizeRel",
    "AppImage",
    "Docker",
    "Flatpak",
    "VM"
  ],
  "test_filters": {
    "unit": {
      "include_labels": "Unit",
      "exclude_labels": "Flaky|Network",
      "parallel": "auto"
    },
    "integration": {
      "include_labels": "Integration",
      "exclude_labels": "Flaky|Network",
      "parallel": 1
    }
  },
  "result_states": [
    "PASS",
    "FAIL",
    "PARTIAL",
    "NOT_RUN",
    "UNVERIFIED"
  ],
  "required_gates": [
    {
      "id": "G0",
      "name": "source_identity",
      "required": true,
      "pass": [
        "correct_repository",
        "main_branch",
        "commit_matches_test_artifacts",
        "working_tree_changes_explained"
      ]
    },
    {
      "id": "G1",
      "name": "windows_toolchain",
      "required": true,
      "pass": [
        "Windows_x64",
        "MSVC_2022_x64",
        "Qt_MSVC_x64",
        "GStreamer_MSVC_x64"
      ]
    },
    {
      "id": "G2",
      "name": "cmake_configure",
      "required": true,
      "pass": [
        "Ninja",
        "Release",
        "QGC_BUILD_TESTING_ON",
        "configure_exit_code_zero"
      ]
    },
    {
      "id": "G3",
      "name": "release_build",
      "required": true,
      "pass": [
        "compile_exit_code_zero",
        "link_exit_code_zero",
        "no_unresolved_build_errors"
      ]
    },
    {
      "id": "G4",
      "name": "unit_tests",
      "required": true,
      "minimum_executed_tests": 1,
      "pass": [
        "junit_exists_and_parses",
        "ctest_exit_code_zero",
        "failures_zero",
        "errors_zero",
        "actual_test_count_recorded"
      ]
    },
    {
      "id": "G5",
      "name": "integration_tests",
      "required": true,
      "minimum_executed_tests": 1,
      "serial": true,
      "pass": [
        "junit_exists_and_parses",
        "ctest_exit_code_zero",
        "failures_zero",
        "errors_zero",
        "actual_test_count_recorded"
      ]
    },
    {
      "id": "G6",
      "name": "build_executable",
      "required": true,
      "pass": [
        "current_release_executable_exists",
        "startup_verification_passes"
      ]
    },
    {
      "id": "G7",
      "name": "installer",
      "required": true,
      "pass": [
        "installer_generated_this_run",
        "installer_sha256_recorded"
      ]
    },
    {
      "id": "G8",
      "name": "clean_install",
      "required": true,
      "pass": [
        "fresh_install_directory",
        "installer_exit_code_zero",
        "installed_executable_exists",
        "gstreamer_plugins_present"
      ]
    },
    {
      "id": "G9",
      "name": "installed_runtime",
      "required": true,
      "pass": [
        "build_sdk_path_removed_or_sanitized",
        "installed_executable_startup_passes"
      ]
    },
    {
      "id": "G10",
      "name": "static_quality",
      "required": true,
      "pass": [
        "applicable_lint_and_format_checks_pass"
      ]
    },
    {
      "id": "G11",
      "name": "evidence",
      "required": true,
      "pass": [
        "unique_run_id",
        "logs_and_junit_archived",
        "sha256_manifest",
        "zip_sha256_sidecar",
        "commit_and_environment_recorded"
      ]
    },
    {
      "id": "G12",
      "name": "non_english_locale_regression",
      "required": true,
      "scope": "windows_release_ci",
      "pass": [
        "unit_host_culture_is_zh_CN",
        "Qt_system_locale_is_zh_CN",
        "unit_application_language_is_English",
        "English_culture_restored_before_integration_and_archive"
      ]
    },
    {
      "id": "G13",
      "name": "flight_telemetry_dashboard_ui",
      "required": true,
      "pass": [
        "dashboard_header_and_read_only_indicator_render",
        "four_summary_tiles_render_with_family_availability_gating",
        "responsive_grid_uses_12_6_1_columns_at_1450_and_760_px_breakpoints",
        "all_existing_diagnostic_families_and_object_names_remain_available",
        "per_family_freshness_badges_do_not_infer_global_health",
        "unknown_invalid_stale_and_recovery_states_are_preserved",
        "no_synthetic_trend_charts_or_control_actions",
        "failsafe_summary_and_detail_color_follow_operation_freshness",
        "dashboard_card_order_matches_information_architecture"
      ]
    },
    {
      "id": "G14",
      "name": "flight_radio_transmitter_ui",
      "required": true,
      "pass": [
        "original_transmitter_svg_is_registered_and_rendered",
        "left_and_right_gimbal_overlays_are_hidden_without_channel_data",
        "live_gimbal_positions_follow_current_stick_mode_channel_mapping",
        "channel_monitor_displays_received_channel_count_and_pwm_values",
        "calibration_save_cancel_bind_and_trim_controls_keep_existing_guards",
        "no_calibration_or_flight_command_is_sent_by_the_visualization_test"
      ]
    }
  ],
  "telemetry_test_matrix": [
    "all_13_FCU_message_families_wire_dispatch",
    "MAVLink_CRC_rejection",
    "wrong_system_and_component_rejection",
    "reserved_enum_boolean_and_mask_rejection",
    "duplicate_and_out_of_order_sample_rejection",
    "boot_id_and_profile_consistency",
    "event_deduplication_and_bounded_history",
    "build_info_digest_chunk_consistency",
    "multi_vehicle_isolation",
    "disconnect_reconnect_state_reset",
    "QML_unknown_invalid_and_stale_presentation",
    "read_only_diagnostics_no_control_authority"
  ],
  "separate_interop_matrix": [
    "Flight_UDP_SIL_normal_interop",
    "packet_loss",
    "packet_reordering",
    "duplicate_frames",
    "disconnect_reconnect",
    "FCU_reboot_with_delayed_old_boot_frames",
    "profile_or_schema_mismatch",
    "burst_load_and_bounded_memory"
  ],
  "interop_rule": "MockLink host integration does not count as Flight UDP SIL interoperability. If the matching Flight sender is unavailable, mark separate interop cases NOT_RUN.",
  "known_contract_issue": "Flight sensor_instance_id publisher order currently conflicts with ICD registry; GroundControl must display raw IDs until the Flight publisher is corrected.",
  "safety_boundary": "Telemetry is diagnostic/read-only. It never authorizes ARM, FMS, Permit, failsafe clearance, or actuator output. Host/SIL does not prove H723 hardware or real-flight release.",
  "issue_workflow": "spec/quality/ISSUE_WORKFLOW.md",
  "evidence_root": "work/validation/archives",
  "test_artifacts": {
    "junit_unit": "build-win-release/junit-results-windows-unit.xml",
    "junit_integration": "build-win-release/junit-results-windows-integration.xml",
    "ctest_unit_log": "work/validation/current/unit-ctest.log",
    "ctest_integration_log": "work/validation/current/integration-ctest.log",
    "report_generator": ".github/scripts/cmake_helper.py ctest"
  },
  "test_environment": {
    "unit_test_host_culture": "zh-CN",
    "unit_qt_system_locale": "zh-CN",
    "unit_application_language": "English",
    "integration_and_archive_host_culture": "en-US"
  },
  "branch_policy": {
    "primary_branch": "main",
    "long_lived_feature_branches": false,
    "force_push": false
  },
  "toolbar_ui_test_matrix": [
    "gps_and_battery_panel_is_adjacent_to_flight_mode",
    "gps_and_battery_indicators_share_dedicated_panel",
    "battery_threshold_colors_follow_configured_thresholds",
    "battery_critical_and_emergency_states_override_percentage",
    "toolbar_indicator_drawers_remain_clickable_and_expandable",
    "unavailable_altitude_hold_mode_is_visible_but_disabled"
  ],
  "spec_sync_policy": "Every current-state claim must identify an exact source HEAD and workflow run. Historical diagnostic evidence remains immutable and must not be promoted to current-main verification. Flight diagnostics dashboard acceptance is defined in spec/Flight-Diagnostics-大屏设计规范.md and enforced by G13. Flight radio transmitter visualization acceptance is defined in spec/Flight-Radio-可视化设计规范.md and enforced by G14.",
  "flight_telemetry_dashboard_ui_matrix": [
    "dashboard_header_and_read_only_indicator_render",
    "telemetry_summary_shows_waiting_without_fcu_frames",
    "operation_summary_is_gated_by_operation_available",
    "failsafe_summary_maps_only_known_protocol_enums",
    "navigation_summary_is_gated_by_navigation_available",
    "responsive_grid_uses_12_6_1_columns_at_1450_and_760_px_breakpoints",
    "diagnostic_cards_show_independent_family_freshness_badges",
    "all_existing_diagnostic_families_and_object_names_remain_available",
    "unknown_invalid_stale_and_recovery_states_are_preserved",
    "no_global_health_score_or_synthetic_time_series",
    "diagnostic_page_remains_read_only",
    "failsafe_summary_and_detail_color_follow_operation_freshness",
    "dashboard_card_order_matches_information_architecture"
  ],
  "flight_radio_ui_matrix": [
    "FlightRadio_page_and_transmitter_artwork_render",
    "no_live_gimbal_marker_without_RC_CHANNELS_data",
    "RC_CHANNELS_wire_path_updates_both_gimbal_positions",
    "Japanese_American_and_Chinese_hand_channel_mapping_is_preserved",
    "channel_monitor_shows_channel_number_and_PWM_value",
    "calibration_and_binding_controls_preserve_existing_enabled_guards",
    "visualization_does_not_send_calibration_or_flight_commands"
  ]
}
