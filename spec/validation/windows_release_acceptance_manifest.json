{
  "schema": "flight-groundcontrol-windows-release-acceptance/1.2",
  "repository": "hujunjie-hub/Flight_GroundControl",
  "branch": "main",
  "delivery": {
    "local_shell": "PowerShell 7",
    "local_validation_before_push": true,
    "remote_verification_after_push": true
  },
  "product_target": {
    "os": "Windows x64",
    "compiler": "MSVC 2022 x64",
    "build_type": "Release",
    "generator": "Ninja"
  },
  "dependency_source": ".github/build-config.json",
  "configured_dependencies": {
    "qt_version_at_manifest_creation": "6.11.1",
    "qt_arch": "win64_msvc2022_64",
    "gstreamer_windows_version_at_manifest_creation": "1.28.4",
    "cmake_minimum": "3.25"
  },
  "forbidden_product_targets": [
    "Linux x64",
    "macOS",
    "iOS",
    "Android",
    "ARM64",
    "Windows Debug",
    "RelWithDebInfo",
    "MinSizeRel",
    "AppImage",
    "Docker",
    "Flatpak",
    "VM"
  ],
  "test_filters": {
    "unit": {
      "include_labels": "Unit",
      "exclude_labels": "Flaky|Network",
      "parallel": "auto"
    },
    "integration": {
      "include_labels": "Integration",
      "exclude_labels": "Flaky|Network",
      "parallel": 1
    }
  },
  "result_states": [
    "PASS",
    "FAIL",
    "PARTIAL",
    "NOT_RUN",
    "UNVERIFIED"
  ],
  "required_gates": [
    {
      "id": "G0",
      "name": "source_identity",
      "required": true,
      "pass": [
        "correct_repository",
        "main_branch",
        "commit_matches_test_artifacts",
        "working_tree_changes_explained"
      ]
    },
    {
      "id": "G1",
      "name": "windows_toolchain",
      "required": true,
      "pass": [
        "Windows_x64",
        "MSVC_2022_x64",
        "Qt_MSVC_x64",
        "GStreamer_MSVC_x64"
      ]
    },
    {
      "id": "G2",
      "name": "cmake_configure",
      "required": true,
      "pass": [
        "Ninja",
        "Release",
        "QGC_BUILD_TESTING_ON",
        "configure_exit_code_zero"
      ]
    },
    {
      "id": "G3",
      "name": "release_build",
      "required": true,
      "pass": [
        "compile_exit_code_zero",
        "link_exit_code_zero",
        "no_unresolved_build_errors"
      ]
    },
    {
      "id": "G4",
      "name": "unit_tests",
      "required": true,
      "minimum_executed_tests": 1,
      "pass": [
        "junit_exists_and_parses",
        "ctest_exit_code_zero",
        "failures_zero",
        "errors_zero",
        "actual_test_count_recorded"
      ]
    },
    {
      "id": "G5",
      "name": "integration_tests",
      "required": true,
      "minimum_executed_tests": 1,
      "serial": true,
      "pass": [
        "junit_exists_and_parses",
        "ctest_exit_code_zero",
        "failures_zero",
        "errors_zero",
        "actual_test_count_recorded"
      ]
    },
    {
      "id": "G6",
      "name": "build_executable",
      "required": true,
      "pass": [
        "current_release_executable_exists",
        "startup_verification_passes"
      ]
    },
    {
      "id": "G7",
      "name": "installer",
      "required": true,
      "pass": [
        "installer_generated_this_run",
        "installer_sha256_recorded"
      ]
    },
    {
      "id": "G8",
      "name": "clean_install",
      "required": true,
