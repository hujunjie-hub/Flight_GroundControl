        "mode_3_mapping_is_verified_for_both_sticks_and_both_axes",
        "channel_labels_and_pwm_readouts_match_each_selected_stick_mode",
        "second_RC_CHANNELS_frame_moves_both_markers_in_all_three_stick_modes",
        "1500us_RC_CHANNELS_frame_centres_both_markers_in_all_three_stick_modes",
        "invalid_axis_channel_hides_only_the_affected_stick_marker",
        "calibration_save_cancel_bind_and_trim_controls_keep_existing_guards",
        "visualization_test_sends_no_calibration_or_flight_control_commands"
      ]
    },
    {
      "id": "G15",
      "name": "flight_telemetry_command_center_phase2",
      "required": true,
      "pass": [
        "flight_state_navigation_and_rc_hero_panels_render_from_real_facts",
        "rc_axis_bars_follow_rc_valid_axes_mask_and_axis_ranges",
        "thirteen_family_health_matrix_shows_independent_status_and_receive_age",
        "four_trend_panels_use_only_fresh_finite_non_negative_live_facts",
        "trend_sampling_is_1hz_bounded_to_60_points_and_uses_existing_page_timer",
        "stale_or_invalid_samples_create_gaps_without_interpolation",
        "trend_buffers_reset_on_vehicle_or_boot_epoch_change",
        "no_attitude_instrument_without_real_attitude_angle_telemetry",
        "all_existing_diagnostic_cards_and_object_names_remain_available",
        "dashboard_remains_read_only_without_new_control_actions"
      ]
    }
  ],
  "telemetry_test_matrix": [
    "all_13_FCU_message_families_wire_dispatch",
    "MAVLink_CRC_rejection",
