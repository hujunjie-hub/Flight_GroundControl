  "interop_rule": "MockLink host integration does not count as Flight UDP SIL interoperability. If the matching Flight sender is unavailable, mark separate interop cases NOT_RUN.",
  "known_contract_issue": "Flight sensor_instance_id publisher order currently conflicts with ICD registry; GroundControl must display raw IDs until the Flight publisher is corrected.",
  "safety_boundary": "Telemetry is diagnostic/read-only. It never authorizes ARM, FMS, Permit, failsafe clearance, or actuator output. Host/SIL does not prove H723 hardware or real-flight release.",
  "issue_workflow": "spec/quality/ISSUE_WORKFLOW.md",
  "evidence_root": "work/validation/archives",
  "test_artifacts": {
