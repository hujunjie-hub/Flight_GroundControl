{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "QGC Build Configuration",
  "description": "Windows x64 MSVC build toolchain versions and settings for QGroundControl CI",
  "type": "object",
  "required": ["qt","build","gstreamer"],
  "properties": {
    "$schema": {"type":"string","description":"JSON Schema reference (ignored by validators)"},
    "qt": {
      "type":"object","required":["version","minimum_version"],"additionalProperties":false,
      "properties":{
        "version":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "minimum_version":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "modules":{"type":"string"}
      }
    },
    "build": {
      "type":"object","required":["cmake_minimum_version","platform_workflows"],"additionalProperties":false,
      "properties":{
        "cmake_minimum_version":{"type":"string","pattern":"^[0-9]+\\.[0-9]+$"},
        "platform_workflows":{"type":"string","const":"Windows","description":"The only supported platform build workflow"}
      }
    },
    "gstreamer": {
      "type":"object","required":["version"],"additionalProperties":false,
      "properties":{
        "version":{
          "type":"object","required":["default","minimum","windows"],"additionalProperties":false,
          "properties":{
            "default":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},
            "minimum":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},
            "windows":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"}
          }
        },
        "plugins":{
          "type":"object","required":["common","windows"],"additionalProperties":false,
          "properties":{
            "common":{"type":"array","items":{"type":"string","pattern":"^[a-z0-9_]+$"}},
            "windows":{"type":"array","items":{"type":"string","pattern":"^[a-z0-9_]+$"}}
          }
        },
        "checksums":{
          "type":"object","description":"Per-version SHA256 checksums for the Windows MSVC x64 SDK",
          "patternProperties":{
            "^[0-9]+\\.[0-9]+\\.[0-9]+$":{
              "type":"object","required":["windows_msvc_x64"],
              "properties":{"windows_msvc_x64":{"type":"string","pattern":"^[a-f0-9]{64}$"}},
              "additionalProperties":false
            }
          },"additionalProperties":false
        }
      }
    }
  },
  "additionalProperties":false
}
